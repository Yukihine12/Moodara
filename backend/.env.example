# ===========================================
# Konfigurasi Server
# ===========================================
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ===========================================
# Konfigurasi PostgreSQL
# ===========================================
DB_HOST=127.0.0.1
DB_USER=moodara_app
DB_PASSWORD=GANTI_DENGAN_PASSWORD_ROLE_MOODARA_APP
DB_NAME=moodara
DB_PORT=5432
DB_SSL=false

# ===========================================
# Autentikasi JWT
# WAJIB diisi. Buat string acak panjang, JANGAN pakai contoh ini.
# Contoh cara generate: openssl rand -base64 48
# ===========================================
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# ===========================================
# Rate Limiting (opsional, ada default aman di kode)
# ===========================================
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
